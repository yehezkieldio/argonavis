{
    "name": "argonavis",
    "version": "1.0.0",
    "license": "MIT",
    "packageManager": "bun@1.2.7",
    "private": true,
    "type": "module",
    "main": "src/index.ts",
    "scripts": {
        "start": "bun run src/index.ts",
        "compose:dev": "docker compose -f ./docker/docker-compose.yml --profile development",
        "compose:o11y": "docker compose -f ./docker/docker-compose.yml --profile observability",
        "format": "biome format . --write",
        "lint": "biome check .",
        "lint:fix": "biome check . --fix --unsafe",
        "typecheck": "tsc --noEmit",
        "db:push": "bun drizzle-kit push",
        "db:studio": "bun drizzle-kit studio",
        "db:generate": "bun --env-file .env drizzle-kit generate",
        "db:drop": "bun drizzle-kit drop",
        "db:migrate": "bun drizzle-kit migrate"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.0",
        "@sapphire/framework": "^5.3.2",
        "@sapphire/time-utilities": "^1.7.14",
        "@t3-oss/env-core": "^0.12.0",
        "consola": "^3.4.2",
        "discord.js": "^14.18.0",
        "drizzle-orm": "^0.41.0",
        "drizzle-zod": "^0.7.0",
        "ofetch": "^1.4.1",
        "postgres": "^3.4.5",
        "ulidx": "^2.4.1",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.0.0-beta.1",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/bun": "^1.2.8",
        "@types/node": "^22.13.14",
        "drizzle-kit": "^0.30.6",
        "typescript": "^5.8.2"
    }
}
